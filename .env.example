# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# Read by Settings in src/eurohistory_rag/core/config.py. Every key here must
# have a matching field on that class: pydantic-settings defaults to
# extra="forbid", so an unrecognised key in .env is a startup error, not a
# silently ignored line. Add fields and keys in the same commit.

# OpenAI: embeddings (text-embedding-3-small, 1536 dims) and generation.
# Required -- there is no sensible default for an API key.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Which model answers. Phase 6. Optional -- defaults to this value.
# A 4.1 rather than a gpt-5: generation runs at temperature 0 so the same
# question gives the same answer, and gpt-5 models reject any temperature
# but their default. A repeatable eval is worth more here than newness.
GENERATION_MODEL=gpt-4.1-mini
# Which model grades faithfulness -- `eurohistory judge`. Phase 10, D-079.
# Optional; defaults to the same model that answers. Leaving it the same means
# the model marks its own homework, which is a documented bias (self-preference).
# Point it at a different family to remove that, and re-run `judge-probe` after:
# a different judge is a different instrument and has to be revalidated.
JUDGE_MODEL=gpt-4.1-mini
# The MediaWiki API requires a descriptive User-Agent with a contact address.
# Requests without one get rate-limited or blocked outright, so this is
# required rather than defaulted: a generic default would appear to work.
# https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIPEDIA_USER_AGENT="eurohistory-rag/0.1 (https://github.com/USER/eurohistory-rag; you@example.com)"

# Qdrant, via docker compose. Phase 5.
# Optional -- defaults to this value; deployment overrides it.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# The reranker. Phase 8, D-070. Both optional -- defaults to these values.
# Runs in this process, so there is no key and no network after the first run,
# which downloads ~280 MB of weights to the HuggingFace cache.
RERANKER_MODEL=BAAI/bge-reranker-base
# Off by default: with it off the system behaves exactly as the Phase 7
# baseline did, so a forgotten flag cannot quietly contaminate a measurement.
RERANKER_ENABLED=false
# Read the reranker's weights while the process starts, rather than inside
# whoever asks first. Phase 25, D-099. Optional -- defaults to ON, unlike every
# other switch here, because it cannot change an answer: it moves who waits, not
# what comes back. Measured in a browser, the first question went 6.5 s to the
# first word and 5.7 s to the passages, against 1.4 s and 0.7 s once warm.
# Set it to false only to reproduce that.
WARM_START=true
# Hybrid search. Phase 9, D-074. Optional -- defaults to off.
# BM25 keyword results fused with the dense ones by reciprocal rank fusion.
# Needs a collection indexed with sparse vectors: an index built before Phase 9
# has no keyword slot, and turning this on against one would find nothing.
HYBRID_ENABLED=false
# Temporal retrieval. Phase 22, D-096. Optional -- defaults to off.
# A third arm restricted to chunks whose year span overlaps the period named in
# the question, fused in beside the others. Needs an index whose payloads carry
# year_start and year_end: run `eurohistory index --payload-only` after a Gold
# rebuild, which costs nothing. With no such payload the arm finds nothing and
# search silently falls back to its old behaviour.
TEMPORAL_ENABLED=false

# At most this many chunks from any one article in a result list. Phase 26,
# D-100. Unset means no cap, which is the measured default: capping per article
# raises how many different articles the five slots hold, and lowers how much of
# the expected material comes back, at every value tried on two corpora.
# Set it to 3 or 2 to re-run that arm; nothing needs rebuilding to flip it.
# MAX_PER_ARTICLE=3

# The groundedness gate. Phase 13, D-084. Both optional -- defaults to these.
# With it on, every answer is sent back to a model together with the sources it
# was written from, and any claim the sources do not support is corrected or
# removed before the answer is returned. Costs one extra call per question and
# roughly doubles both the latency and the token bill.
VERIFY_ENABLED=false
# Which model checks. Defaults to the answering model, which means the writer
# proofreads itself -- point it at another family to remove that.
VERIFY_MODEL=gpt-4.1-mini

# The two cost ceilings. Phase 30, D-104. Enforced in code, before a single
# question is asked -- not in the confirmation dialog, which states a price and
# then trusts whoever is at the keyboard. Both are dollars.
#
# MAX_RUN_DOLLARS refuses one evaluation whose quote exceeds it. $0.50 is about
# three and a half runs of the current 106 questions at the measured $0.1364,
# so an ordinary run never touches it and a question set that has quietly
# tripled does.
MAX_RUN_DOLLARS=0.50
# MAX_DAY_DOLLARS is what this machine may spend in one UTC day across
# everything that calls a model, /ask included. This is the one that notices a
# loop. The day's running total lives in data/spend/, which is gitignored and
# is the only thing under data/ that cannot be rebuilt from Bronze -- delete it
# and the day starts again.
MAX_DAY_DOLLARS=1.00
